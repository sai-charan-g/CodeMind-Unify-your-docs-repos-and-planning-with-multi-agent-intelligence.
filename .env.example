# ============================================
# DevPilot AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# ---------- General ----------
APP_NAME=DevPilot AI
APP_ENV=development
DEBUG=true

# ---------- Backend (FastAPI) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------- Database (PostgreSQL / Neon) ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devpilot
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/devpilot

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- JWT ----------
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ---------- Google Gemini ----------
GOOGLE_API_KEY=your-google-api-key

# ---------- ChromaDB ----------
CHROMA_HOST=localhost
CHROMA_PORT=8100

# ---------- Encryption (for storing GitHub tokens) ----------
ENCRYPTION_KEY=your-fernet-encryption-key
